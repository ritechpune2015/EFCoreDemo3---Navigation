@model IEnumerable<Emp>
<!DOCTYPE html>
    <html>
    <head>
        <title></title>
    </head>
    <body>
       <h2> Emp List </h2>
       <table>
           <thead>
               <tr>
                   <th> Emp ID </th>
                   <th> Emp Name </th>
                   <th> Email ID</th>
                   <th> Mobile No </th>
                   <th> Dept Name</th>
                   <th>Area Name</th>
               </tr>
           </thead>
           <tbody>
            @foreach (var temp in Model)
            {
               <tr>
                   <td>@temp.EmpID</td>
                   <td>@temp.EmpName</td>
                   <td>@temp.EmailID</td>
                   <td>@temp.MobileNo</td>
                   <td>@temp.DeptObj.DeptName</td>
                   <td>
                       @temp.DeptObj.Area.AreaName
                   </td>
               </tr>  
             
            }
    </table>
    </body>
    </html>